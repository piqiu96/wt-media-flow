# 比特浏览器
BIT_API_URL=http://127.0.0.1:54345

# 数据库
DATABASE_URL=sqlite:///store/publisher.db

# 日志
LOG_LEVEL=INFO
LOG_FILE=log/publisher.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# 发布时间
PUBLISH_START_HOUR=8
PUBLISH_END_HOUR=23

# 外部工具；留空时自动查找 bin/ 或系统 PATH
FFMPEG_PATH=
YTDLP_PATH=

# 下载
DOWNLOAD_DIR=data/downloads
DOWNLOAD_TIMEOUT=300

# 通知；留空时不发送
WECOM_WEBHOOK_URL=

# AI 标题生成；留空时跳过
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/anthropic

# 合成
GUIDE_DIR=data/guides
OUTPUT_DIR=data/output
OVERLAY_DIR=data/overlays
OVERLAY_SOURCE_DIR=data/overlay_sources
STICKER_DIR=data/stickers
DEFAULT_INSERT_AT=10
DEFAULT_INSERT_RANGE=10-20
DEFAULT_MAX_DURATION=180
VIDEO_CODEC=libx264
AUDIO_CODEC=aac
